# Ollama Configuration (Optimized for 8GB RAM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
TEMPERATURE=0.1

# ChromaDB Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=excel_rag_collection

# Ingestion Configuration
EXCEL_FILE_PATH=documents/knowledge_base.xlsx
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=4

# Security & Guardrails
MAX_QUERY_LENGTH=2000
MAX_REQUEST_BODY_SIZE_BYTES=1048576
LLM_TIMEOUT_SECONDS=60.0
REQUEST_TIMEOUT_SECONDS=90.0

# Rate Limiting
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_QUERY=20/minute
RATE_LIMIT_INGEST=5/minute

